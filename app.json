{
  "expo": {
    "name": "Moves?",
    "slug": "moves",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moves",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.movesquestion.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Moves uses your location to show nearby public Moves and to set the location of Moves you host.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.movesquestion.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Moves uses your location to show nearby public Moves and to set the location of Moves you host."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Moves uses your photo library so you can set a profile picture."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Moves can check your contacts against people already on Moves to suggest friends - numbers never leave your device unhashed."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ac5a676-f9b8-4279-85e1-73090504dfd4"
      }
    },
    "owner": "scnpg"
  }
}
